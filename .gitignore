# === Large external dependencies ===
# Fetched locally by the setup scripts, never committed.
hog2/                 # scripts/setup.sh
benchmarks/           # scripts/fetch-benchmarks.sh

# Python bytecode
__pycache__/
*.pyc

# The old workspace/ tree: HOG2, benchmarks and raw run output live here
# untracked. Our code moved to src/, cluster/, scripts/ at the repo root.
workspace/

# === Build artifacts ===
bin/
**/bin/
**/build/objs/
*.o
*.a
*.exe
a.out

# === Run artifacts ===
# results/ IS committed: it is the evidence the report's numbers rest on.
# What is ignored here is the raw per-map dumps that aggregate into it.
raw-results/
cluster/logs/
cluster/manifest*.tsv
*.log
*.tmp

# === Not part of this repository ===
# The report lives with the submission, not here. This repo is the code and the
# commands needed to reproduce the experiments behind it.
deliverables/
# The assignment brief and grading guidelines are the instructor's material.
instructions/
# Third-party papers: cite them, do not host them. These are publisher PDFs and
# redistributing them is not ours to do.
resources/
# Agent and editor tooling.
.claude/
.vscode/
.idea/

# === OS cruft ===
.DS_Store
*.swp
*~
