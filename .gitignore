# === Large external dependencies (cloned/downloaded locally, not committed) ===
# HOG2 search framework — clone with workspace/scripts/setup.sh
workspace/hog2/
# Warthog voxel-map benchmarks — download with workspace/scripts/fetch-benchmarks.sh
workspace/benchmarks/
# Live Overleaf project (git bridge clone, read-only mirror) — see REPO_GUIDE.md
deliverables/report/overleaf-live/

# === Build artifacts ===
workspace/**/bin/
workspace/**/build/objs/
*.o
*.a
*.out
*.exe
a.out

# === Experiment outputs (keep curated results in deliverables/, ignore raw dumps) ===
workspace/results/
*.log
*.tmp

# === Cluster run artifacts (generated) ===
workspace/bin/
workspace/cluster/logs/
workspace/cluster/manifest*.tsv

# === Papers: PDFs can be large; uncomment to keep them out of git ===
# resources/papers/*.pdf

# === OS / editor cruft ===
.DS_Store
*.swp
.idea/
.vscode/
*~

# Overleaf upload folder — keep only the source files (.tex, .sty, .bst, .bib)
deliverables/report/overleaf/*.pdf
deliverables/report/overleaf/*.aux
deliverables/report/overleaf/*.log
deliverables/report/overleaf/*.out
# .bbl IS committed: AAAI camera-ready expects it, and it lets a single
# pdflatex pass resolve citations without running bibtex.
!deliverables/report/overleaf/report.bbl
deliverables/report/overleaf/*.blg
deliverables/report/overleaf/*.fls
deliverables/report/overleaf/*.fdb_latexmk
